# Supabase - get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret for admin sessions (generate a random 32+ char string)
JWT_SECRET=change_this_to_a_random_secret_string_32chars_min

# Admin credentials (initial setup - can be changed from admin panel)
ADMIN_EMAIL=admin@mhstart.com
ADMIN_PASSWORD_HASH=will_be_set_on_first_run

# Email / SMTP settings (configure in admin panel too)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=MHStart <noreply@mhstart.com>

# Site URL
NEXT_PUBLIC_SITE_URL=https://mhstart.com
